<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ADAS_Components</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SWC_BrakeActuator</SHORT-NAME>
          <DESC>AUTOSAR Application SWC SWC_BrakeActuator for ADAS control sub-system</DESC>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>P_SWC_BrakeActuator_Command</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/Interfaces/I_SWC_BrakeActuator_Out</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>R_SWC_BrakeActuator_SensorInput</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF>/Interfaces/I_SWC_BrakeActuator_In</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <SWC-INTERNAL-BEHAVIOR>
            <SHORT-NAME>SWC_BrakeActuator_Behavior</SHORT-NAME>
            <RUNNABLES>
              <RUNNABLE-ENTITY>
                <SHORT-NAME>RE_SWC_BrakeActuator_Step</SHORT-NAME>
                <SYMBOL>SWC_BrakeActuator_Step</SYMBOL>
              </RUNNABLE-ENTITY>
              <RUNNABLE-ENTITY>
                <SHORT-NAME>RE_SWC_BrakeActuator_Init</SHORT-NAME>
                <SYMBOL>SWC_BrakeActuator_Init</SYMBOL>
              </RUNNABLE-ENTITY>
            </RUNNABLES>
          </SWC-INTERNAL-BEHAVIOR>
        </APPLICATION-SW-COMPONENT-TYPE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>I_SWC_BrakeActuator_Out</SHORT-NAME>
          <DESC>Sender Receiver Interface for SWC_BrakeActuator outputs</DESC>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>DE_SWC_BrakeActuator_Signal</SHORT-NAME>
              <TYPE-TREF>/AUTOSAR/Platform/uint32</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>I_SWC_BrakeActuator_In</SHORT-NAME>
          <DESC>Sender Receiver Interface for SWC_BrakeActuator inputs</DESC>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>DE_SWC_BrakeActuator_RawData</SHORT-NAME>
              <TYPE-TREF>/AUTOSAR/Platform/uint16</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
