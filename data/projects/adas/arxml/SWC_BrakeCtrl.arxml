<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ADAS_Components</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SWC_BrakeCtrl</SHORT-NAME>
          <DESC>AUTOSAR Application SWC SWC_BrakeCtrl for ADAS control</DESC>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>P_SWC_BrakeCtrl_Command</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/Interfaces/I_SWC_BrakeCtrl_Out</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>R_SWC_BrakeCtrl_SensorInput</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF>/Interfaces/I_SWC_BrakeCtrl_In</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <SWC-INTERNAL-BEHAVIOR>
            <SHORT-NAME>SWC_BrakeCtrl_Behavior</SHORT-NAME>
            <RUNNABLES>
              <RUNNABLE-ENTITY>
                <SHORT-NAME>RE_SWC_BrakeCtrl_Step</SHORT-NAME>
                <SYMBOL>SWC_BrakeCtrl_Step</SYMBOL>
              </RUNNABLE-ENTITY>
            </RUNNABLES>
          </SWC-INTERNAL-BEHAVIOR>
        </APPLICATION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
